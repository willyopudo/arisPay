# Vault bootstrap
VAULT_DEV_ROOT_TOKEN_ID=replace-with-dev-root-token

# Config server credentials + config DB access
CONFIG_SERVER_USERNAME=replace-with-config-server-username
CONFIG_SERVER_PASSWORD=replace-with-config-server-password
CONFIG_DB_USERNAME=postgres
CONFIG_DB_PASSWORD=replace-with-config-db-password

# Application DB/bootstrap values
ARISPAY_DB_HOST=host.docker.internal
ARISPAY_DB_PORT=5432
ARISPAY_DB_NAME=arispay_db
ARISPAY_DB_USERNAME=postgres
ARISPAY_DB_PASSWORD=replace-with-application-db-password
ARISPAY_DB_PASSWORD_PROD=replace-with-application-db-password-prod

# Redis
ARISPAY_REDIS_PASSWORD=replace-with-redis-password
ARISPAY_REDIS_PASSWORD_PROD=replace-with-redis-password-prod

# JWT
ARISPAY_JWT_SECRET=replace-with-jwt-secret-dev
ARISPAY_JWT_SECRET_PROD=replace-with-jwt-secret-prod

# Vault-seeded shared tokens
EUREKA_SHARED_SECRET_DEV=replace-with-eureka-shared-secret-dev
EUREKA_SHARED_SECRET_PROD=replace-with-eureka-shared-secret-prod
ZIPKIN_TOKEN_DEV=replace-with-zipkin-token-dev
ZIPKIN_TOKEN_PROD=replace-with-zipkin-token-prod
PAYMENT_GATEWAY_API_KEY_DEV=replace-with-payment-gateway-key-dev
PAYMENT_GATEWAY_API_KEY_PROD=replace-with-payment-gateway-key-prod

# Optional non-secret URLs
ARISPAY_OPENAPI_DEV_URL=http://localhost:8082
ARISPAY_OPENAPI_PROD_URL=https://arispay.com
